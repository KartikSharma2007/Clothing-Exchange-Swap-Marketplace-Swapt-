# Frontend env — copy to .env and fill your LAN IP for mobile testing
# Find your LAN IP: open PowerShell → ipconfig → look for "IPv4 Address" under your Wi-Fi adapter (e.g. 192.168.1.42)

# PC only (localhost) — works for http://localhost:8080 → http://localhost:4000
VITE_API_URL=http://localhost:4000

# LAN / Mobile — replace <LAN_IP> with your ipconfig result:
# VITE_API_URL=http://<LAN_IP>:4000
# Example: VITE_API_URL=http://192.168.1.42:4000

VITE_GOOGLE_CLIENT_ID=306166237343-s8tfav4m3kgsb85fkop37391h3d4bmc7.apps.googleusercontent.com
# Optional LAN VAPID etc are backend-only
